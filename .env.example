# ─────────────────────────────────────────────────────────────
# ELORAÉ — environment variables
# Copy this file to .env.local for local development, and add the
# same variables in Vercel → Project → Settings → Environment Variables
# for production. Every value below is optional — the site builds and
# runs with sensible defaults if you leave a variable unset.
# ─────────────────────────────────────────────────────────────

# --- Site ---
# Your production URL. Used for SEO metadata and the sitemap.
# Get it from Vercel after your first deploy (e.g. https://elorae.vercel.app).
NEXT_PUBLIC_SITE_URL=https://elorae.vercel.app

# --- Pricing (AED) ---
# The current selling price and the "was" price shown struck through.
# Set both equal to hide the discount badge.
NEXT_PUBLIC_PRODUCT_PRICE=89
NEXT_PUBLIC_PRODUCT_COMPARE_PRICE=129

# Multi-unit bundle offers on the shop section. Set to false to sell one
# unit only. Each tier's total price (AED) is set independently — not a
# formula — since bulk pricing is a business call.
NEXT_PUBLIC_BUNDLES_ENABLED=true
NEXT_PUBLIC_BUNDLE_1_PRICE=89
NEXT_PUBLIC_BUNDLE_2_PRICE=159
NEXT_PUBLIC_BUNDLE_3_PRICE=219
NEXT_PUBLIC_BUNDLE_4_PRICE=279
NEXT_PUBLIC_BUNDLE_5_PRICE=329
NEXT_PUBLIC_BUNDLE_6_PRICE=379
# Which tier (by unit count) is presented as the recommended/hero bundle.
NEXT_PUBLIC_BUNDLE_RECOMMENDED_UNITS=3

# Optional extra fees (AED). Leave at 0 if you don't charge these.
NEXT_PUBLIC_SHIPPING_FEE=0
NEXT_PUBLIC_COD_FEE=0

# --- Fulfillment ---
# Only enable payment methods you can actually fulfill.
NEXT_PUBLIC_COD_ENABLED=true
NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=false
NEXT_PUBLIC_DELIVERY_DAYS_MIN=2
NEXT_PUBLIC_DELIVERY_DAYS_MAX=4
NEXT_PUBLIC_RETURN_POLICY_DAYS=7

# --- Product attributes ---
# Only set to true once verified against the real product spec sheet —
# the site hides any claim tied to a false/unset flag rather than guessing.
NEXT_PUBLIC_ATTR_RECHARGEABLE=false
NEXT_PUBLIC_ATTR_COMPACT=false
NEXT_PUBLIC_ATTR_EASY_CLEAN=false
NEXT_PUBLIC_ATTR_WATERPROOF=false

# --- Contact ---
# WhatsApp Business number in E.164 digits, no leading +, e.g. 971501234567.
# Leave empty to hide all WhatsApp buttons/CTAs site-wide.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Support email shown in the footer, FAQ and order confirmation.
NEXT_PUBLIC_SUPPORT_EMAIL=support@elorae.ae

# --- Analytics (optional) ---
# Meta Pixel ID from Meta Events Manager (business.facebook.com/events_manager).
# Leave empty to disable Meta Pixel — the site works fully without it.
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 Measurement ID from analytics.google.com (starts with "G-").
# Leave empty to disable GA — the site works fully without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
